{
  "name": "amicro-sv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Inoffizieller SvelteKit-Port von Amicro (React). Nicht mit dem Original verbunden.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:amicro": "node tests/amicro-gallery.mjs",
    "registry:generate": "node scripts/generate-registry.mjs",
    "registry:build": "pnpm registry:generate && shadcn-svelte registry build",
    "start": "node build"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.1.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "playwright": "^1.61.1",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.1.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@lucide/svelte": "^0.545.0",
    "clsx": "^2.1.1",
    "layerchart": "^2.1.0",
    "motion": "^11.15.0",
    "motion-sv": "^0.1.13",
    "runed": "^0.34.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
